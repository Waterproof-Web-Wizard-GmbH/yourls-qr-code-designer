{
    "name": "waterproof/yourls-qr-code-designer",
    "description": "YOURLS plugin for styled QR codes: colours, gradients, dot and corner shapes, dot gap, logo at a safe position, print check, built-in scan test, PNG, SVG and JPG export.",
    "type": "yourls-plugin",
    "license": "MIT",
    "keywords": [
        "yourls",
        "yourls-plugin",
        "qr-code",
        "qr-code-generator",
        "qrcode",
        "logo",
        "url-shortener",
        "short-url",
        "print",
        "svg",
        "privacy"
    ],
    "homepage": "https://github.com/Waterproof-Web-Wizard-GmbH/yourls-qr-code-designer",
    "authors": [
        {
            "name": "Waterproof Web Wizard GmbH",
            "email": "hallo@waterproof.agency",
            "homepage": "https://waterproof-web-wizard.com/"
        }
    ],
    "support": {
        "issues": "https://github.com/Waterproof-Web-Wizard-GmbH/yourls-qr-code-designer/issues",
        "source": "https://github.com/Waterproof-Web-Wizard-GmbH/yourls-qr-code-designer"
    },
    "require": {
        "php": ">=8.1",
        "composer/installers": "^2.0"
    },
    "extra": {
        "installer-paths": {
            "user/plugins/{$name}/": [
                "type:yourls-plugin"
            ]
        }
    }
}
